msgid "We'll email you a code."
msgstr "Kodni emailingizga yuboramiz."

#: accounts/views.py:179
msgid "Too many sign-up attempts — please try again later."
msgstr ""
"Roʻyxatdan oʻtish urinishlari juda koʻp — keyinroq qayta urinib koʻring."

#: accounts/views.py:212 accounts/views.py:336
msgid "No account for that address."
msgstr "Bu manzil uchun hisob topilmadi."

#: accounts/views.py:245
msgid "Too many username changes — please try again later."
msgstr ""
"Foydalanuvchi nomi juda koʻp marta oʻzgartirildi — keyinroq qayta urinib "
"koʻring."

#: accounts/views.py:358
msgid ""
"That username or email was taken while you were verifying — please start "
"over."
msgstr ""
"Siz tasdiqlayotgan paytda bu foydalanuvchi nomi yoki email band boʻlib qoldi "
"— qaytadan boshlang."

