# Copy to .env and fill in real values. .env is gitignored — never commit it.
#
# Not every process needs every variable. config.py groups them by role:
#   core  DATABASE_URL                          every process
#   web   DJANGO_SECRET_KEY                     the Django site
#   etl   TMDB_API_KEY, AWS_*, S3_BUCKET        the pipeline
# Local development wants all of them. The hosted site needs only core + web —
# it reads the warehouse and calls nothing else — which is why the deployed
# function holds no S3 write credentials. See config.py's module docstring.

# --- TMDB API ---
# Get a key at https://www.themoviedb.org/settings/api (v3 auth)
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# --- AWS / S3 Data Lake ---
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=eu-central-1
S3_BUCKET=your-datalake-bucket-name

# --- PostgreSQL Warehouse ---
# Format: postgresql+psycopg2://user:password@host:port/dbname
# The warehouse this process reads/writes:
#   * locally, a Postgres on localhost — the fast replica Django serves from;
#   * in the nightly GitHub Actions job, the Neon instance (source of truth),
#     supplied as the DATABASE_URL repo secret, with ?sslmode=require appended.
DATABASE_URL=postgresql+psycopg2://postgres:64826080@localhost:5432/theoria_1

# User accounts, email codes, sessions and collections live in a separate
# durable database, never in the ETL-owned warehouse above. Local development
# CAN derive the sibling database name `theoria_app` when this is blank (see
# settings.py), but that database still has to exist and be migrated — set
# this explicitly and run `python manage.py migrate` before first use.
# Deployed environments (Vercel) must set this; there is no derivation there.
APP_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/theoria_app

# Neon endpoint, set LOCALLY ONLY. scripts/sync_warehouse_from_neon.py uses it to
# pull Neon -> the local replica above (run it when you sit down to work, after
# the nightly job has finished). The cloud job never sets this — it writes Neon
# through DATABASE_URL directly. Leave blank if you are not running a local replica.
NEON_DATABASE_URL=

# --- Ingestion tuning ---
MAX_PAGES=5

# Corpus design for the discover/movie source (--source discover).
# Defines which films exist in the warehouse: the most-voted titles of each
# year in the range that clear the vote floor.
DISCOVER_START_YEAR=1970
DISCOVER_END_YEAR=2026
DISCOVER_PAGES_PER_YEAR=1
DISCOVER_MIN_VOTES=300

# Corpus design for the discover/tv source (--with-tv, Task 77+). Defaults match
# the movie values above, so TV needs no new entry here; override only to widen
# or narrow the series catalogue.
TV_DISCOVER_START_YEAR=1970
TV_DISCOVER_END_YEAR=2026
TV_DISCOVER_PAGES_PER_YEAR=1
TV_DISCOVER_MIN_VOTES=300

# Season/episode ingestion (Task 82). Bound how many newly seen series get their
# seasons fetched per run; the tail fills over later nights. Specials (season 0)
# are skipped unless TV_SEASONS_INCLUDE_SPECIALS is truthy.
TV_SEASONS_MAX_NEW=300
TV_SEASONS_INCLUDE_SPECIALS=False

# --- IMDb datasets ---
# Public bulk exports, refreshed daily by IMDb — no auth/key/quota needed.
# title.episode.tsv.gz (Task 83) maps every episode to its parent series +
# season/episode number, so each episode gets an IMDb id and rating with no
# per-episode API call.
IMDB_RATINGS_URL=https://datasets.imdbws.com/title.ratings.tsv.gz
IMDB_EPISODES_URL=https://datasets.imdbws.com/title.episode.tsv.gz

# --- Django ---
DJANGO_SECRET_KEY=change_me_in_production
DJANGO_DEBUG=True

# Local default: print verification codes in the Django terminal, no
# credentials required. For deployed environments, switch to the SMTP
# backend and fill in EMAIL_HOST_* for any SMTP-speaking transactional
# provider (Resend, Brevo, Mailgun, SES, ...).
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DEFAULT_FROM_EMAIL=Theoria <no-reply@example.com>
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.your-provider.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-username
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=True

# --- Google OAuth ---
# Create a Web application OAuth client in Google Cloud Console. The redirect
# URI is optional locally: when blank, Django derives it from the current host
# as /auth/google/callback/. Set it explicitly in production.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback/
